{
  "info": {
    "name": "Lab 04 - Order Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "product_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "base_url",
      "value": "http://localhost:3003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "product_b_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{auth_url}}/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"student\",\n  \"password\": \"U3R1ZGVudEAxMjM=\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Product A",
      "request": {
        "method": "POST",
        "url": "{{product_url}}/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sản phẩm A\",\n  \"price\": 120000,\n  \"quantity\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"product_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Product B",
      "request": {
        "method": "POST",
        "url": "{{product_url}}/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sản phẩm B\",\n  \"price\": 50000,\n  \"quantity\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"product_b_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Nguyễn Văn A\",\n  \"customer_email\": \"a@example.com\",\n  \"items\": [\n    {\n      \"product_id\": {{product_id}},\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set(\"order_id\", data.id); pm.collectionVariables.set(\"item_id\", data.items[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List Orders",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/orders",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Order Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/orders/{{order_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "List Items",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/order_items",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Item Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/order_items/{{item_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Update Item",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/order_items/{{item_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 3\n}"
        }
      }
    },
    {
      "name": "Delete Item",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/order_items/{{item_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Add Item",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/order_items",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": {{order_id}},\n  \"product_id\": {{product_id}},\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"item_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add Product B",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/order_items",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": {{order_id}},\n  \"product_id\": {{product_b_id}},\n  \"quantity\": 1\n}"
        }
      }
    },
    {
      "name": "Insufficient Stock",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Khách hàng\",\n  \"customer_email\": \"b@example.com\",\n  \"items\": [\n    {\n      \"product_id\": {{product_id}},\n      \"quantity\": 999\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Update Status",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/orders/{{order_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        }
      }
    },
    {
      "name": "Delete Order",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/orders/{{order_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}